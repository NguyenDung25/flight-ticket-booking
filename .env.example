
MONGO_URI=mongodb://localhost:27017/flight-ticket-booking

# Sinh bằng lệnh: npx auth secret
AUTH_SECRET=

# VNPay sandbox — đăng ký tại https://sandbox.vnpayment.vn/devreg/, VNPay gửi Terminal ID + Secret Key qua email
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# AirLabs (https://airlabs.co) — dùng cho script seed và tự điền lịch bay
AIRLABS_API_KEY=

# SMTP gửi email vé (Gmail cần App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Chỉ đặt true khi app chạy sau proxy tin cậy (ngrok, Nginx) — để lấy IP thật từ X-Forwarded-For
# cho chống dò mã check-in. Để trống/false khi chạy localhost trực tiếp (xem lib/clientIp.js).
TRUST_PROXY=
